{
  "name": "dsh-session-archive",
  "version": "0.5.8",
  "description": "给 DSH 加一个「会话档案库」：把同工作区的旧会话当储存区，新会话可以 list / digest / read / search，还能量化思考退化的程度。",
  "type": "module",
  "license": "MIT",
  "author": "小怜",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "memory",
    "context",
    "archive"
  ],
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "read_session.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "install.ps1"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
